# Deny all web access to the data directory (JSON storage).
# The data directory should live outside the public web root when possible;
# this is the fallback protection for shared hosting (InfinityFree).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
